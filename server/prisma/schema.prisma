// ==================== CAMPAIGN & QUEUE MODELS ====================

model Campaign {
  id               String              @id @default(uuid())
  name             String              @map("title")
  subject          String
  body             String              @db.Text @map("bodyTemplate")
  status           String              @default("draft") // draft, queued, sending, completed, cancelled, paused
  scheduledAt      DateTime            @default(now())
  priority         String              @default("medium") // low, medium, high
  createdBy        String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  recipients       CampaignRecipient[]
  emailQueues      EmailQueue[]

  // Campaign configurations
  campaignType     String              @default("newsletter") @map("templateType")
  tone             String              @default("friendly") // friendly, professional, formal, conversational, premium, encouraging, urgent
  optimizationGoal String?
  primaryObjective String?
  targetContext    String?
  totalCount       Int                 @default(0)
  sentCount        Int                 @default(0)
  failedCount      Int                 @default(0)
  openCount        Int                 @default(0)
  clickCount       Int                 @default(0)

  // Relationships
  campaignQueues   CampaignQueue[]
  emailLogs        EmailLog[]
  aiEmails         AIEmail[]
  schedules        CampaignSchedule[]
  analytics        CampaignAnalytics?

  @@map("EmailCampaign")
  @@index([status])
  @@index([scheduledAt])
}

model CampaignRecipient {
  id             String         @id @default(uuid())
  campaignId     String
  campaign       Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userId         String?
  recipientEmail String
  recipientName  String?
  variables      Json?          // dynamic variables (e.g. firstName, lastName)
  status         String         @default("pending") // pending, queued, sent, failed, opened, clicked, bounced
  sentAt         DateTime?
  openedAt       DateTime?
  clickedAt      DateTime?
  bouncedAt      DateTime?
  errorMessage   String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  emailQueue     EmailQueue?
  campaignQueue  CampaignQueue?

  @@unique([campaignId, recipientEmail])
  @@index([campaignId])
  @@index([recipientEmail])
  @@index([status])
}

model EmailQueue {
  id                String             @id @default(uuid())
  campaignId        String
  campaign          Campaign           @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  recipientId       String             @unique
  recipient         CampaignRecipient  @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  email             String
  status            String             @default("pending") // pending, queued, sending, completed, failed
  attempts          Int                @default(0)
  lastError         String?
  scheduledFor      DateTime           @default(now())
  processingStarted DateTime?
  completedAt       DateTime?
  logs              EmailLogs[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([status])
  @@index([scheduledFor])
  @@index([campaignId])
}

model EmailLogs {
  id           String      @id @default(uuid())
  queueId      String
  emailQueue   EmailQueue  @relation(fields: [queueId], references: [id], onDelete: Cascade)
  smtpProvider String      @default("nodemailer")
  messageId    String?
  status       String // sent, failed, bounced, opened, clicked
  error        String?
  response     String?
  createdAt    DateTime    @default(now())

  @@index([queueId])
  @@index([status])
}

model CampaignTemplate {
  id           String   @id @default(uuid())
  name         String
  subject      String
  bodyTemplate String   @db.Text
  type         String // newsletter, scholarship, promotion, onboarding, custom
  tone         String // friendly, professional, formal, conversational, premium, encouraging, urgent
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model CampaignQueue {
  id                String             @id @default(uuid())
  campaignId        String
  campaign          Campaign           @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  recipientId       String             @unique
  recipient         CampaignRecipient  @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  email             String
  status            String             @default("pending") // pending, queued, generating, sending, sent, failed, cancelled, paused
  attempts          Int                @default(0)
  lastError         String?
  scheduledFor      DateTime           @default(now())
  processingStarted DateTime?
  completedAt       DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([status])
  @@index([scheduledFor])
}

model CampaignAnalytics {
  id             String   @id @default(uuid())
  campaignId     String   @unique
  campaign       Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  totalSent      Int      @default(0)
  totalOpened    Int      @default(0)
  totalClicked   Int      @default(0)
  totalBounced   Int      @default(0)
  totalFailed    Int      @default(0)
  totalReplied   Int      @default(0)
  totalUnsubscribed Int   @default(0)
  totalSpam      Int      @default(0)
  conversionRate Float    @default(0.0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model EmailLog {
  id             String    @id @default(uuid())
  campaignId     String?
  campaign       Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  recipientEmail String
  subject        String
  status         String // sent, failed, bounced, opened, clicked, unsubscribed, spam
  errorMessage   String?
  smtpProvider   String    @default("nodemailer")
  sentAt         DateTime  @default(now())
  openedAt       DateTime?
  clickedAt      DateTime?
  createdAt      DateTime  @default(now())

  @@index([campaignId])
  @@index([status])
}

model AIEmail {
  id              String   @id @default(uuid())
  campaignId      String
  campaign        Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  subject         String
  previewText     String?
  body            String   @db.Text
  cta             String?
  footer          String?
  spamScore       Float    @default(0.0)
  confidenceScore Float    @default(0.0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model AutomationRule {
  id           String   @id @default(uuid())
  name         String
  triggerEvent String // e.g. "Application Submitted", "Loan Approved", "Missing Passport", "Offer Letter Uploaded", "Visa Approved", "EMI Due"
  templateId   String
  priority     String   @default("medium") // low, medium, high
  tone         String   @default("friendly")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model CampaignAudience {
  id          String   @id @default(uuid())
  name        String
  description String?
  filters     Json // Store structured filters for Country, University, Course, Intake, Loan Status, etc.
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CampaignSchedule {
  id             String    @id @default(uuid())
  campaignId     String
  campaign       Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  scheduledAt    DateTime
  cronExpression String?   // standard 5-field cron expression for recurring campaigns
  status         String    @default("pending") // pending, executed, cancelled
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status])
  @@index([scheduledAt])
}

model Parent {
  id           String   @id @default(uuid())
  userId       String
  relation     String   // father, mother, coapplicant
  name         String?
  aadharNumber String?
  panNumber    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, relation])
  @@index([userId])
  @@map("parents")
}

// ─── Support Ticket Management ────────────────────────────────────────────────

model SupportTicket {
  id           String @id @default(uuid())
  ticketNumber String @unique // TKT-00001 format

  subject     String
  description String @db.Text
  category    String // Loan Application, OCR, EVV, Payment, etc.
  priority    String @default("medium") // critical, high, medium, low
  status      String @default("open") // open, assigned, in_progress, waiting_customer, resolved, closed
  source      String @default("web")

  // Creator
  createdById    String
  createdByName  String
  createdByEmail String
  createdByRole  String // user, agent, staff, bank, admin

  // Assignment
  assignedToId   String?
  assignedToName String?
  teamId         String?
  teamName       String?
  departmentId   String?
  departmentName String?

  // Related loan context
  loanApplicationId  String?
  loanApplicationNum String?
  loanStage          String?
  studentId          String?
  studentName        String?
  assignedAgentId    String?
  assignedBankerId   String?
  universityName     String?

  // SLA
  slaBreached     Boolean   @default(false)
  slaResponseAt   DateTime?
  slaResolveAt    DateTime?
  firstResponseAt DateTime?
  resolvedAt      DateTime?
  closedAt        DateTime?
  reopenedAt      DateTime?

  // Satisfaction
  satisfactionScore Int?
  satisfactionNote  String?

  tags String[]

  comments      SupportComment[]
  attachments   SupportAttachment[]
  activityLogs  SupportActivityLog[]
  notifications SupportNotification[]
  watchers      SupportWatcher[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([priority])
  @@index([category])
  @@index([createdById])
  @@index([assignedToId])
  @@index([createdAt])
  @@index([slaBreached])
  @@index([ticketNumber])
}

model SupportComment {
  id       String        @id @default(uuid())
  ticketId String
  ticket   SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  authorId   String
  authorName String
  authorRole String
  content    String  @db.Text
  type       String  @default("public") // public, internal_note
  isInternal Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ticketId])
  @@index([authorId])
}

model SupportAttachment {
  id       String        @id @default(uuid())
  ticketId String
  ticket   SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  fileName       String
  filePath       String
  fileSize       Int?
  mimeType       String?
  uploadedBy     String
  uploadedByName String

  createdAt DateTime @default(now())

  @@index([ticketId])
}

model SupportActivityLog {
  id       String        @id @default(uuid())
  ticketId String
  ticket   SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  actorId   String
  actorName String
  action    String // created, status_changed, priority_changed, assigned, commented, resolved, closed, reopened
  oldValue  String?
  newValue  String?
  metadata  Json?

  createdAt DateTime @default(now())

  @@index([ticketId])
  @@index([createdAt])
}

model SupportNotification {
  id       String         @id @default(uuid())
  ticketId String?
  ticket   SupportTicket? @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  userId   String
  title    String
  message  String
  type     String // new_ticket, assigned, status_changed, comment_added, resolved
  isRead   Boolean   @default(false)
  readAt   DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([ticketId])
  @@index([isRead])
}

model SupportWatcher {
  id       String        @id @default(uuid())
  ticketId String
  ticket   SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId   String
  userName String

  createdAt DateTime @default(now())

  @@unique([ticketId, userId])
